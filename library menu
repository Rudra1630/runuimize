#include<iostream>
using namespace std;

int main() 
{
    int book[10];
    int n = 0;
    int choice;
    int search;

    do
    {
        cout << "\n========SMART LIBRARY======";
        cout << "\n1. Add book";
        cout << "\n2. Display book";
        cout << "\n3. Search book";
        cout << "\n4. Exit";
        cout << "\n5. Enter your choice: ";
        cin >> choice;

        if (choice == 1)
        {
            cout << "Enter Book IDS: ";
            cin >> book[n];
            n++;
            cout << "Book Added!";
        }
        else if (choice == 2)
        {
            cout << "\nBooks in Library:\n";
            for (int i = 0; i < n; i++)
            {
                cout << book[i] << endl;
            }
        }
        else if (choice == 3)
        {
            cout << "Enter Book ID to search: ";
            cin >> search;
            bool found = false;
            for (int i = 0; i < n; i++)
            {
                if (book[i] == search)
                {
                    found = true;
                }
            }
            if (found)
            {
                cout << "Book Found!";
            }
            else
            {
                cout << "Book Not Found!";
            }
        }
        else if (choice == 4)
        {
            cout << "Thank you";
        }
        else
        {
            cout << "Invalid Choice";
        }
    } while (choice != 4);
    
    return 0;
}
